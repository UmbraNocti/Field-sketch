{
  "name": "Field Sketch",
  "short_name": "Field Sketch",
  "description": "Quick kitchen sketching for the field",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#fbfaf6",
